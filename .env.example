# Copy to .env and fill in locally. Never commit .env.
# Names only. Real values come by private message.

# ---- LLM (S1-T9-1) ----
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=

# ---- Database and Redis (S0-T2-1) ----
# Inside docker compose, DATABASE_URL and REDIS_URL are set by
# infra/docker-compose.yml. Fill them only to run the API outside Docker.
DATABASE_URL=
REDIS_URL=
NEON_DATABASE_URL=
UPSTASH_REDIS_URL=
