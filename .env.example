# Copy to .env and fill in locally. Never commit .env.
# Names only. Real values come by private message.

# ---- LLM (S1-T9-1) ----
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=
GROQ_MODEL=

# ---- Database and Redis (S0-T2-1) ----
# Inside docker compose, DATABASE_URL and REDIS_URL are set by
# infra/docker-compose.yml. Fill them only to run the API outside Docker.
DATABASE_URL=
REDIS_URL=
NEON_DATABASE_URL=
UPSTASH_REDIS_URL=

# ---- RAG: area guides + developer profiles (S2-M1-10) ----
# 0 = offline in-memory search (no key needed). 1 = pgvector + Gemini embeddings.
USE_REAL_RAG=0
GEMINI_EMBED_MODEL=gemini-embedding-001
# Hits below this similarity are dropped (0 to 1). Empty = keep all.
RAG_MIN_SCORE=
# Default: data/docs in the repo.
RAG_DOCS_DIR=
# gemini (default when GEMINI_API_KEY is set) or hash (offline, for tests).
RAG_EMBEDDER=
