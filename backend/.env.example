# AqarAI Backend Configuration
# Copy this file to .env and configure with your actual values
# NEVER commit .env to version control

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aqar

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication (REQUIRED for production)
JWT_SECRET=your-secret-key-here-change-this-in-production

# CORS - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Feature flags - Set to true/false or 1/0
USE_REAL_LISTINGS=false
USE_REAL_FINANCE=false
USE_REAL_RAG=false
USE_REAL_CONVERSATIONS=false
USE_REAL_LEADS=false
USE_REAL_AGENT=false

# LLM Configuration (from existing llm.py)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
# Or for Groq:
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile
